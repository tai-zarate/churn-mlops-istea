# Copiar como .env y completar con credenciales propias.
# Obtener el token en: https://dagshub.com/user/settings/tokens

MLFLOW_TRACKING_URI=https://dagshub.com/tai-zarate/churn-mlops-istea.mlflow
MLFLOW_TRACKING_USERNAME=tu-usuario-dagshub
MLFLOW_TRACKING_PASSWORD=tu-token-dagshub

# Versión del modelo registrada en MLflow Model Registry
MODEL_VERSION=1















